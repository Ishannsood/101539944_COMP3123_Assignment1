# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=3000
NODE_ENV=development

# Local MongoDB, or your MongoDB Atlas connection string.
# The database name is forced to "comp3123_assignment1" in code.
MONGODB_URI=mongodb://127.0.0.1:27017/comp3123_assignment1

# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Rate limiting (optional overrides)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MIN=15
